PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/
# Database name (set explicitly — do not rely on Mongo default "test")
MONGODB_DB_NAME=gcc-resort-crm
JWT_SECRET=change-this-to-a-long-random-secret

# --- Resort sheet sync (Sheet -> App one-way mirror) ---
# Published CSV export of the GCC enquiry sheet. Leave blank to use the built-in default.
RESORT_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/1lSSgLKZsQ8VXnRFLK7u9lN_eSFUzz5cuRG9UOw0xefA/export?format=csv&gid=84625495
# How often to auto-pull the sheet, in minutes (0 disables the interval).
RESORT_SYNC_INTERVAL_MIN=10

# --- Meta ads leads sync (Meta-Report tab) ---
# Leave blank to use the built-in default (Meta-Report tab).
META_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/14e44atgJYVKmC3nnTnSpRLTqt7gOIcY7kL-rmkJpb7Y/export?format=csv&gid=500636204
META_SYNC_INTERVAL_MIN=10

# --- AI assistant (dashboard "Ask AI" bot) ---
# OpenAI-compatible provider. Default is Groq (free tier). Without a key the bot is disabled.
# Get a free Groq key at https://console.groq.com/keys
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# --- Email (Google Workspace Gmail, via service account + domain-wide delegation) ---
# Key file defaults to backend/google-service-account.json. On a host, paste the JSON
# (or its base64) into GOOGLE_SERVICE_ACCOUNT_JSON instead.
# GOOGLE_SERVICE_ACCOUNT_FILE=
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GMAIL_MAILBOXES=enquiries@goldcoinsresort.in,events@goldcoinsresort.in,reserve@goldcoinsresort.in,bookings@goldcoinsresort.in,sales@goldcoinsresort.in,khingpar@goldcoinsresort.in
# EMAIL_FROM_NAME=Gold Coins Resort
# EMAIL_SYNC_INTERVAL_SEC=90

# --- Call transcription (Calls tab "Transcribe") ---
# Speech-to-text for Exotel recordings. Free Groq key: https://console.groq.com/keys
# The server's outbound IP must be whitelisted in Exotel for recording downloads.
TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIBE_MODEL=whisper-large-v3
# Caller ID customers see on click-to-call (defaults to 08045680780)
# EXOTEL_CALLER_ID=
